# direnv environment. Committed — contains NO secrets, only identifiers.
# Override anything locally in .envrc.local (gitignored).
#
#   direnv allow

# ---------------------------------------------------------------------------
# Sandbox identifiers. Not secret — a project ID is a name, not a credential.
# ---------------------------------------------------------------------------
export GCP_PROJECT="${GCP_PROJECT:-clgcporg10-152}"
export GCP_REGION="${GCP_REGION:-europe-west1}"
export GCP_ZONE="${GCP_ZONE:-${GCP_REGION}-b}"

# ---------------------------------------------------------------------------
# Terraform picks TF_VAR_* up automatically, so terraform.tfvars becomes
# optional and the scripts below need no positional arguments.
# ---------------------------------------------------------------------------
export TF_VAR_project_id="${GCP_PROJECT}"
export TF_VAR_region="${GCP_REGION}"
export TF_VAR_zone="${GCP_ZONE}"

# admin_cidr is deliberately NOT auto-detected here. direnv runs on every cd,
# and silently rewriting the CIDR that gates your own control-plane access is a
# good way to lock yourself out mid-demo. Set it explicitly, and re-check it on
# the morning of the panel with `just myip`.
# ⚠️ PRECEDENCE: terraform.tfvars BEATS TF_VAR_*. setup-lab.sh writes admin_cidr
# there, so this export is ignored while tfvars defines it. Edit tfvars to change
# it for real — `just myip` checks the live value and tells you if it has drifted.
[ -n "${ADMIN_CIDR:-}" ] && export TF_VAR_admin_cidr="${ADMIN_CIDR}"

# ---------------------------------------------------------------------------
# GKE auth plugin. kubectl needs `gke-gcloud-auth-plugin` on PATH to talk to a
# GKE control plane. Homebrew installs the Cloud SDK under share/ and symlinks
# only `gcloud` into bin/, so the plugin is present but invisible — kubectl then
# fails with "executable gke-gcloud-auth-plugin not found" even though
# `gcloud components list` shows it Installed.
# ---------------------------------------------------------------------------
if ! has gke-gcloud-auth-plugin; then
  for _sdk in /opt/homebrew/share/google-cloud-sdk/bin \
              /usr/local/share/google-cloud-sdk/bin \
              "$HOME/google-cloud-sdk/bin"; do
    if [ -x "$_sdk/gke-gcloud-auth-plugin" ]; then
      PATH_add "$_sdk"
      log_status "PATH += $_sdk (gke-gcloud-auth-plugin)"
      break
    fi
  done
fi
export USE_GKE_GCLOUD_AUTH_PLUGIN=True

# ---------------------------------------------------------------------------
# Local overrides, e.g. ADMIN_CIDR or a different project.
# ---------------------------------------------------------------------------
[ -f .envrc.local ] && source_env .envrc.local

log_status "project=${GCP_PROJECT} region=${GCP_REGION} zone=${GCP_ZONE}"
